<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StackBar-Setup</AssemblyName>
    <RootNamespace>StackBar.Installer</RootNamespace>
    <ApplicationIcon>..\TaskbarGrouper\Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\TaskbarGrouper\Assets\app_icon.png" Link="Assets\app_icon.png" />
    <Resource Include="..\TaskbarGrouper\Assets\app_icon.ico" Link="Assets\app_icon.ico" />
    <EmbeddedResource Include="Payload\payload.zip" Condition="Exists('Payload\payload.zip')" />
  </ItemGroup>

</Project>
