<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>StackBar</AssemblyName>
    <!-- Default for local builds; the release workflow overrides it with the tag version (-p:Version=X.Y.Z) -->
    <Version>1.1.0</Version>
    <RootNamespace>TaskbarGrouper</RootNamespace>
    <ApplicationIcon>Assets\app_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>TaskbarGrouper.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <!-- Portable Edition: build.ps1 builds a second exe with -p:StackBarEdition=Portable, which runs portable
       under any file name. Separate output folders keep it from overwriting the normal build. -->
  <PropertyGroup Condition="'$(StackBarEdition)' == 'Portable'">
    <OutputPath>bin\Portable\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\Portable\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(StackBarEdition)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>StackBarEdition</_Parameter1>
      <_Parameter2>$(StackBarEdition)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StackBar.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.png" />
    <Resource Include="Assets\app_icon.ico" />
  </ItemGroup>

</Project>
