<Window x:Class="TaskbarGrouper.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StackBar Flyout"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Left="-32000"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Caret Arrow (when taskbar is at top) -->
        <Canvas x:Name="TopCaretCanvas" Grid.Row="0" Height="8" HorizontalAlignment="Stretch" Visibility="Collapsed" ClipToBounds="False">
            <Polygon x:Name="TopCaretPolygon" Points="0,8 16,8 8,0" Fill="#F614151D" Stroke="#33FFFFFF" StrokeThickness="1"/>
        </Canvas>

        <!-- Main Card -->
        <Border x:Name="RootBorder"
                Grid.Row="1"
                CornerRadius="16"
                BorderThickness="1.2"
                Padding="16,14,16,14"
                RenderTransformOrigin="0.5,1.0"
                Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="TopGradStop" Color="#F21E202B" Offset="0.0"/>
                    <GradientStop Color="#F614151D" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="BorderAccentStop" Color="#55FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#22FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PopupScale" ScaleX="0.92" ScaleY="0.92"/>
                    <TranslateTransform x:Name="PopupTranslate" Y="10"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="Black"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <DockPanel Margin="2,0,2,8">
                    <Button DockPanel.Dock="Right"
                            Click="EditStackButton_Click"
                            ToolTip="Open in StackBar Studio"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="6,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Gb" CornerRadius="6" Padding="6,3" Background="Transparent">
                                    <TextBlock Text="⚙" Foreground="#88FFFFFF" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Gb" Property="Background" Value="#25FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border DockPanel.Dock="Right"
                            CornerRadius="8"
                            Background="#1FFFFFFF"
                            Padding="7,2"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ItemCountBadge" Text="0" Foreground="#AAFFFFFF" FontSize="10.5" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AccentDot" Width="8" Height="8" CornerRadius="4" Background="#3A6DF0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GroupTitleText" Text="Stack" Foreground="#F5FFFFFF" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <!-- Divider -->
                <Border Height="1" Background="#16FFFFFF" Margin="0,0,0,10"/>

                <!-- Empty State Message -->
                <TextBlock x:Name="EmptyNotice"
                           Text="This stack is empty. Open Studio to add apps."
                           Foreground="#77FFFFFF"
                           FontSize="12"
                           TextAlignment="Center"
                           Margin="16,12"
                           Visibility="Collapsed"/>

                <!-- Grid -->
                <ItemsControl x:Name="ItemsGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="ItemButton_Click"
                                    Tag="{Binding}"
                                    Width="82"
                                    Height="{Binding TileHeight}"
                                    Margin="3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="{Binding ToolTipText}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Launch App" Click="ContextLaunch_Click" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Run as Administrator" Click="ContextRunAdmin_Click" CommandParameter="{Binding}" Visibility="{Binding AdminOptionVisibility}"/>
                                        <MenuItem Header="Open File Location" Click="ContextOpenLocation_Click" CommandParameter="{Binding}" Visibility="{Binding FileLocationVisibility}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ItemBorder"
                                                CornerRadius="12"
                                                Background="#08FFFFFF"
                                                BorderBrush="#12FFFFFF"
                                                BorderThickness="1"
                                                Padding="6">
                                            <Grid>
                                                <TextBlock Text="{Binding HotkeyHint}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           FontSize="9"
                                                           Foreground="#44FFFFFF"
                                                           Margin="0,-2,2,0"/>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid Width="38" Height="38" Margin="0,2,0,4">
                                                        <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}"
                                                               Visibility="{Binding LabelVisibility}"
                                                               Foreground="#EEFFFFFF"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="70"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#48FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#40FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Bottom Caret Arrow (when taskbar is at bottom) -->
        <Canvas x:Name="BottomCaretCanvas" Grid.Row="2" Height="8" HorizontalAlignment="Stretch" ClipToBounds="False">
            <Polygon x:Name="BottomCaretPolygon" Points="0,0 16,0 8,8" Fill="#F614151D" Stroke="#33FFFFFF" StrokeThickness="1"/>
        </Canvas>
    </Grid>
</Window>
