<Window x:Class="TaskbarGrouper.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StackBar Flyout"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Left="-32000"
        Opacity="0"
        Loaded="Window_Loaded"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        KeyDown="Window_KeyDown">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Caret Arrow (when taskbar is at top) -->
        <Canvas x:Name="TopCaretCanvas" Grid.Row="0" Height="8" HorizontalAlignment="Stretch" Visibility="Collapsed" ClipToBounds="False">
            <Polygon x:Name="TopCaretPolygon" Points="0,8 16,8 8,0" Fill="#F614151D" Stroke="#33FFFFFF" StrokeThickness="1"/>
        </Canvas>

        <!-- Main Card -->
        <Border x:Name="RootBorder"
                Grid.Row="1"
                CornerRadius="16"
                BorderThickness="1.2"
                AllowDrop="True"
                DragOver="RootBorder_DragOver"
                Drop="RootBorder_Drop"
                Padding="16,14,16,14"
                RenderTransformOrigin="0.5,1.0"
                Opacity="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="TopGradStop" Color="#F21E202B" Offset="0.0"/>
                    <GradientStop Color="#F614151D" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="BorderAccentStop" Color="#55FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#22FFFFFF" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PopupScale" ScaleX="0.92" ScaleY="0.92"/>
                    <TranslateTransform x:Name="PopupTranslate" Y="10"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="Black"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <DockPanel Margin="2,0,2,8">
                    <Button x:Name="EditStackButton"
                            DockPanel.Dock="Right"
                            Click="EditStackButton_Click"
                            ToolTip="Open in StackBar Studio"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            Padding="6,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Gb" CornerRadius="6" Padding="6,3" Background="Transparent">
                                    <TextBlock Text="⚙" Foreground="#BBFFFFFF" FontSize="12"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Gb" Property="Background" Value="#25FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="DoneButton"
                            DockPanel.Dock="Right"
                            Click="DoneButton_Click"
                            ToolTip="Finish rearranging"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Margin="0,0,6,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#3A6DF0" CornerRadius="6" Padding="10,3">
                                    <TextBlock Text="Done" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border DockPanel.Dock="Right"
                            CornerRadius="8"
                            Background="#1FFFFFFF"
                            Padding="7,2"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ItemCountBadge" Text="0" Foreground="#AAFFFFFF" FontSize="10.5" FontWeight="SemiBold"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="AccentDot" Width="8" Height="8" CornerRadius="4" Background="#3A6DF0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GroupTitleGlyph" Text="📁" FontSize="13.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="GroupTitleText"
                                   Text="Stack"
                                   Foreground="#F5FFFFFF"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Cursor="Hand"
                                   ToolTip="Click to rename"
                                   MouseLeftButtonDown="GroupTitleText_MouseLeftButtonDown"/>
                        <Button x:Name="RenameButton"
                                Click="RenameButton_Click"
                                ToolTip="Rename stack"
                                Cursor="Hand"
                                Focusable="False"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Rb" CornerRadius="5" Padding="4,1" Background="Transparent">
                                        <TextBlock Text="✏" Foreground="#88FFFFFF" FontSize="11"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Rb" Property="Background" Value="#25FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBox x:Name="GroupTitleBox"
                                 Visibility="Collapsed"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="White"
                                 Background="#252736"
                                 BorderBrush="#3A6DF0"
                                 BorderThickness="1"
                                 Padding="6,2"
                                 VerticalAlignment="Center"
                                 MinWidth="100"
                                 KeyDown="GroupTitleBox_KeyDown"
                                 LostFocus="GroupTitleBox_LostFocus"/>
                        <!-- Not focusable, so clicking them doesn't first commit through the TextBox's LostFocus -->
                        <Button x:Name="RenameSaveButton"
                                Click="RenameSaveButton_Click"
                                ToolTip="Save name (Enter)"
                                Cursor="Hand"
                                Focusable="False"
                                Visibility="Collapsed"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="22" Height="22" CornerRadius="6" Background="#3A6DF0">
                                        <TextBlock Text="✓" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="RenameCancelButton"
                                Click="RenameCancelButton_Click"
                                ToolTip="Cancel (Esc)"
                                Cursor="Hand"
                                Focusable="False"
                                Visibility="Collapsed"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Cb" Width="22" Height="22" CornerRadius="6" Background="#22FFFFFF">
                                        <TextBlock Text="✕" Foreground="#DDFFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Cb" Property="Background" Value="#38FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Divider -->
                <Border Height="1" Background="#16FFFFFF" Margin="0,0,0,10"/>

                <!-- Empty State Message -->
                <TextBlock x:Name="EmptyNotice"
                           Text="This stack is empty. Open Studio to add apps."
                           Foreground="#77FFFFFF"
                           FontSize="12"
                           TextAlignment="Center"
                           Margin="16,12"
                           Visibility="Collapsed"/>

                <!-- Grid -->
                <ItemsControl x:Name="ItemsGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columns}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="ItemButton_Click"
                                    PreviewMouseLeftButtonDown="ItemButton_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="ItemButton_PreviewMouseMove"
                                    PreviewMouseLeftButtonUp="ItemButton_PreviewMouseLeftButtonUp"
                                    Tag="{Binding}"
                                    Width="82"
                                    Height="{Binding TileHeight}"
                                    Margin="3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    AllowDrop="True"
                                    Drop="ItemButton_Drop"
                                    DragOver="ItemButton_DragOver"
                                    ToolTip="{Binding ToolTipText}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Launch App" Click="ContextLaunch_Click" CommandParameter="{Binding}"/>
                                        <MenuItem Header="Run as Administrator" Click="ContextRunAdmin_Click" CommandParameter="{Binding}" Visibility="{Binding AdminOptionVisibility}"/>
                                        <MenuItem Header="Open File Location" Click="ContextOpenLocation_Click" CommandParameter="{Binding}" Visibility="{Binding FileLocationVisibility}"/>
                                        <Separator/>
                                        <MenuItem Header="Rearrange / Edit Apps (Hold Icon)" Click="ContextRearrange_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ItemBorder"
                                                CornerRadius="12"
                                                Background="#08FFFFFF"
                                                BorderBrush="#12FFFFFF"
                                                BorderThickness="1"
                                                Padding="6"
                                                Opacity="{Binding TileOpacity}"
                                                RenderTransformOrigin="0.5,0.5">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="{Binding TileScale}" ScaleY="{Binding TileScale}"/>
                                                    <RotateTransform x:Name="JiggleRot" Angle="0"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <Grid>
                                                <TextBlock Text="{Binding HotkeyHint}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Top"
                                                           FontSize="9"
                                                           Foreground="#44FFFFFF"
                                                           Margin="0,-2,2,0"/>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Grid Width="38" Height="38" Margin="0,2,0,4">
                                                        <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}"
                                                               Visibility="{Binding LabelVisibility}"
                                                               Foreground="#EEFFFFFF"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               TextAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="70"/>
                                                </StackPanel>

                                                <!-- Delete (✕) Badge in Jiggle Mode -->
                                                <Button x:Name="DeleteBadge"
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="-2,-2,0,0"
                                                        Visibility="{Binding DeleteBadgeVisibility}"
                                                        Click="DeleteBadge_Click"
                                                        Tag="{Binding}"
                                                        Cursor="Hand"
                                                        Focusable="False">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Width="18" Height="18" CornerRadius="9" Background="#E53935" BorderBrush="White" BorderThickness="1.2">
                                                                <TextBlock Text="✕" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2AFFFFFF"/>
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#48FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#40FFFFFF"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsJiggling}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="JiggleStoryboard">
                                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                            <DoubleAnimation Storyboard.TargetName="JiggleRot"
                                                                             Storyboard.TargetProperty="Angle"
                                                                             From="-2.2" To="2.2"
                                                                             Duration="0:0:0.12"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="JiggleStoryboard"/>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Bottom Caret Arrow (when taskbar is at bottom) -->
        <Canvas x:Name="BottomCaretCanvas" Grid.Row="2" Height="8" HorizontalAlignment="Stretch" ClipToBounds="False">
            <Polygon x:Name="BottomCaretPolygon" Points="0,0 16,0 8,8" Fill="#F614151D" Stroke="#33FFFFFF" StrokeThickness="1"/>
        </Canvas>
    </Grid>
</Window>
