<Window x:Class="TaskbarGrouper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StackBar — Taskbar Folder Studio"
        Width="980"
        Height="640"
        MinWidth="860"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="#12131A"
        Foreground="White">

    <Window.Resources>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#3A6DF0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4E7FF7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2956CE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SurfaceBtn" TargetType="Button">
            <Setter Property="Background" Value="#252734"/>
            <Setter Property="Foreground" Value="#EEFFFFFF"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303344"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E202B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#1EFFFFFF"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#181922"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3A6DF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" Background="#1B1C26" CornerRadius="14" Padding="14" BorderBrush="#22FFFFFF" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="4,2,4,14">
                    <Image Source="pack://application:,,,/Assets/app_icon.png" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="StackBar" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="ModeBadgeText" Text="Taskbar Folder Studio v1.1" FontSize="10.5" Foreground="#88FFFFFF"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Content="+ Create New Stack"
                            Click="AddGroup_Click"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="0,0,0,8"/>
                    <Button Content="Delete Selected Stack"
                            Click="DeleteGroup_Click"
                            Style="{StaticResource SurfaceBtn}"
                            Foreground="#FF7B7B"
                            FontSize="11.5"
                            Margin="0,0,0,12"/>

                    <Border Background="#14151D" CornerRadius="8" Padding="10,8" BorderBrush="#1CFFFFFF" BorderThickness="1">
                        <CheckBox x:Name="RunAtStartupCheck"
                                  Content="Run in Tray at Windows Startup"
                                  Foreground="#CCFFFFFF"
                                  FontSize="11.5"
                                  VerticalContentAlignment="Center"
                                  Checked="RunAtStartupCheck_Changed"
                                  Unchecked="RunAtStartupCheck_Changed"/>
                    </Border>
                </StackPanel>

                <ListBox x:Name="GroupsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="GroupsListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,3"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBd" Background="#14151D" CornerRadius="10" Padding="10,8" BorderBrush="#18FFFFFF" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBd" Property="Background" Value="#232533"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBd" Property="Background" Value="#292C3E"/>
                                                <Setter TargetName="ItemBd" Property="BorderBrush" Value="#3A6DF0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="8" Background="#18FFFFFF" Margin="0,0,10,0" Padding="1">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} apps in folder'}" FontSize="11" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right Content -->
        <Border Grid.Column="2" Background="#1B1C26" CornerRadius="14" Padding="20" BorderBrush="#22FFFFFF" BorderThickness="1">
            <DockPanel x:Name="GroupEditorPanel">
                <!-- Top Header Card -->
                <Border DockPanel.Dock="Top" Background="#14151D" CornerRadius="12" Padding="16" Margin="0,0,0,14" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Content="👁 Preview Flyout"
                                        Click="PreviewFlyout_Click"
                                        Style="{StaticResource SurfaceBtn}"
                                        Margin="0,0,8,0"/>
                                <Button Content="📌 Create Taskbar Shortcut"
                                        Click="CreateShortcut_Click"
                                        Style="{StaticResource PrimaryBtn}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="12" Background="#1E202B" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,14,0" Padding="2" Cursor="Hand" MouseLeftButtonDown="LiveFolderIconPreview_Click" ToolTip="Click to pick custom icon">
                                    <Image x:Name="LiveFolderIconPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectedGroupHeader" Text="Select a Stack" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="SelectedGroupSubtext" Text="Customize folder appearance and apps below" FontSize="11.5" Foreground="#88FFFFFF" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- Controls -->
                        <WrapPanel Grid.Row="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                                <TextBlock Text="Folder Name:" Foreground="#AAFFFFFF" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="GroupNameBox" Width="135" Style="{StaticResource DarkTextBox}" TextChanged="GroupMeta_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                                <TextBlock Text="Emoji:" Foreground="#AAFFFFFF" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button x:Name="EmojiPickerBtn" Click="EmojiPickerBtn_Click" Style="{StaticResource SurfaceBtn}" Padding="8,4" Cursor="Hand" ToolTip="Click to select folder emoji">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedEmojiDisplay" Text="📁" FontSize="15" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="▾" FontSize="9" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="EmojiPickerPopup" StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=EmojiPickerBtn}" Placement="Bottom">
                                    <Border Background="#1C1E2A" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                                        </Border.Effect>
                                        <StackPanel Width="270">
                                            <TextBlock Text="Select Folder Emoji" Foreground="#AAFFFFFF" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,6"/>
                                            <WrapPanel x:Name="EmojiPalettePanel">
                                                <!-- Populated in code-behind with categorized emojis -->
                                            </WrapPanel>
                                            <Border Height="1" Background="#20FFFFFF" Margin="0,8,0,6"/>
                                            <Button Content="Windows Emoji Panel (Win + .)" Click="OpenWindowsEmojiPanel_Click" Style="{StaticResource SurfaceBtn}" FontSize="11" Padding="4,4"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>

                            <!-- Theme swatches -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                                <TextBlock Text="Accent:" Foreground="#AAFFFFFF" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton x:Name="ColorBlue" GroupName="AccentColor" Tag="#3A6DF0" Checked="AccentRadio_Checked" Margin="2,0" Cursor="Hand" ToolTip="Ocean Blue">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#3A6DF0"/>
                                    </RadioButton>
                                    <RadioButton x:Name="ColorPurple" GroupName="AccentColor" Tag="#8B5CF6" Checked="AccentRadio_Checked" Margin="2,0" Cursor="Hand" ToolTip="Neon Purple">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#8B5CF6"/>
                                    </RadioButton>
                                    <RadioButton x:Name="ColorEmerald" GroupName="AccentColor" Tag="#10B981" Checked="AccentRadio_Checked" Margin="2,0" Cursor="Hand" ToolTip="Emerald Green">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#10B981"/>
                                    </RadioButton>
                                    <RadioButton x:Name="ColorAmber" GroupName="AccentColor" Tag="#F59E0B" Checked="AccentRadio_Checked" Margin="2,0" Cursor="Hand" ToolTip="Amber Orange">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#F59E0B"/>
                                    </RadioButton>
                                    <RadioButton x:Name="ColorRed" GroupName="AccentColor" Tag="#EF4444" Checked="AccentRadio_Checked" Margin="2,0" Cursor="Hand" ToolTip="Crimson Red">
                                        <Border Width="16" Height="16" CornerRadius="8" Background="#EF4444"/>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>

                            <!-- Icon Style Radio -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                                <TextBlock Text="Style:" Foreground="#AAFFFFFF" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <RadioButton x:Name="StyleGridRadio" GroupName="IconStyle" Content="2x2 Grid" Checked="StyleRadio_Checked" Foreground="#DDD" FontSize="11.5" Margin="0,0,6,0" Cursor="Hand"/>
                                <RadioButton x:Name="StyleEmojiRadio" GroupName="IconStyle" Content="Emoji" Checked="StyleRadio_Checked" Foreground="#DDD" FontSize="11.5" Margin="0,0,6,0" Cursor="Hand"/>
                                <RadioButton x:Name="StyleCustomRadio" GroupName="IconStyle" Content="Custom Icon" Checked="StyleRadio_Checked" Foreground="#DDD" FontSize="11.5" Cursor="Hand"/>
                            </StackPanel>

                            <CheckBox x:Name="ShowLabelsCheck"
                                      Content="Show App Names"
                                      Foreground="#CCFFFFFF"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Margin="0,4,0,4"
                                      Checked="ShowLabelsCheck_Changed"
                                      Unchecked="ShowLabelsCheck_Changed"/>
                        </WrapPanel>

                        <!-- Style Context Toolbar (Row 3) -->
                        <Border Grid.Row="3" Margin="0,10,0,0" Padding="10,6" Background="#0DFFFFFF" CornerRadius="8" BorderBrush="#16FFFFFF" BorderThickness="1">
                            <Grid>
                                <!-- Custom Icon Bar -->
                                <DockPanel x:Name="CustomIconBar" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                        <Button Content="📁 Choose Icon / File..." Click="ChooseCustomIcon_Click" Style="{StaticResource SurfaceBtn}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Content="⚡ Use 1st App" Click="UseFirstAppIcon_Click" Style="{StaticResource SurfaceBtn}" Padding="8,4" FontSize="11" ToolTip="Use first app in this stack as folder cover icon" Margin="0,0,6,0"/>
                                        <Button Content="✕ Clear" Click="ClearCustomIcon_Click" Style="{StaticResource SurfaceBtn}" Padding="8,4" FontSize="11" ToolTip="Clear custom icon and revert"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CustomIconPathLabel" Text="No custom icon chosen. Pick a file (.ico, .png, .exe) or click ★ on any app below." Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                </DockPanel>

                                <!-- Emoji Quick Presets Bar -->
                                <DockPanel x:Name="EmojiPresetsBar" Visibility="Collapsed">
                                    <TextBlock Text="Quick Presets:" Foreground="#88FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Content="🎮" Tag="🎮" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Gaming"/>
                                        <Button Content="💻" Tag="💻" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Development / Code"/>
                                        <Button Content="🌐" Tag="🌐" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Web &amp; Browsers"/>
                                        <Button Content="💬" Tag="💬" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Chat &amp; Social"/>
                                        <Button Content="🎵" Tag="🎵" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Music &amp; Audio"/>
                                        <Button Content="🎨" Tag="🎨" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Design &amp; Creative"/>
                                        <Button Content="🛠️" Tag="🛠️" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Utilities &amp; Tools"/>
                                        <Button Content="📁" Tag="📁" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Documents &amp; Work"/>
                                        <Button Content="🤖" Tag="🤖" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="AI &amp; Assistants"/>
                                        <Button Content="🚀" Tag="🚀" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Launch &amp; Favorites"/>
                                        <Button Content="⭐" Tag="⭐" Click="EmojiPreset_Click" Style="{StaticResource SurfaceBtn}" Width="28" Height="26" Padding="0" Margin="2,0" ToolTip="Star / Featured"/>
                                    </WrapPanel>
                                </DockPanel>

                                <!-- Grid 2x2 Info -->
                                <TextBlock x:Name="GridModeInfo" Text="The taskbar icon renders the first 4 apps in this folder as an iOS/macOS-style 2x2 mini grid." Foreground="#77FFFFFF" FontSize="11" VerticalAlignment="Center" Visibility="Visible"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Bottom Bar -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="⚡ Import From Taskbar / System"
                                Click="ImportTaskbar_Click"
                                Style="{StaticResource SurfaceBtn}"
                                Foreground="#7CB3FF"
                                Margin="0,0,8,0"/>
                        <Button Content="+ Add App / Shortcut..."
                                Click="AddAppFile_Click"
                                Style="{StaticResource SurfaceBtn}"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Text="Drag &amp; drop any .exe or .lnk files into the list, or import from taskbar."
                               FontSize="11.5"
                               Foreground="#88FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"/>
                </DockPanel>

                <!-- List & Empty Overlay -->
                <Grid>
                    <ListBox x:Name="ItemsListBox"
                             Background="#14151D"
                             BorderBrush="#22FFFFFF"
                             BorderThickness="1"
                             Foreground="White"
                             HorizontalContentAlignment="Stretch"
                             AllowDrop="True"
                             Drop="ItemsListBox_Drop">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="6,3"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBd" Background="#1B1D28" CornerRadius="8" Padding="10,7" BorderBrush="#16FFFFFF" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#242736"/>
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#33FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="#282C3E"/>
                                                    <Setter TargetName="RowBd" Property="BorderBrush" Value="#3A6DF0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <TextBox Grid.Column="1"
                                             Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DarkTextBox}"
                                             FontWeight="SemiBold"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TargetPath}"
                                               Foreground="#77FFFFFF"
                                               FontSize="11.5"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding TargetPath}"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Button Content="★" ToolTip="Set this app's icon as the Stack folder cover" Tag="{Binding}" Click="SetAsFolderIcon_Click" Style="{StaticResource RowActionBtn}" Foreground="#FFD700"/>
                                        <Button Content="↑" ToolTip="Move Up" Tag="{Binding}" Click="MoveItemUp_Click" Style="{StaticResource RowActionBtn}"/>
                                        <Button Content="↓" ToolTip="Move Down" Tag="{Binding}" Click="MoveItemDown_Click" Style="{StaticResource RowActionBtn}"/>
                                        <Button Content="✕" ToolTip="Remove App" Tag="{Binding}" Click="RemoveRowItem_Click" Style="{StaticResource RowActionBtn}" Foreground="#FF8080"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border x:Name="EmptyStateOverlay"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"
                            Margin="24"
                            CornerRadius="12"
                            BorderBrush="#28FFFFFF"
                            BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📥" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="This Stack folder is empty" FontSize="15" FontWeight="SemiBold" Foreground="#DDFFFFFF" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click '⚡ Import From Taskbar' below, or drag &amp; drop shortcuts here" FontSize="12" Foreground="#77FFFFFF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
