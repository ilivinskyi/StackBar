<Window x:Class="TaskbarGrouper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StackBar — Taskbar Folder Manager"
        Width="900"
        Height="580"
        WindowStartupLocation="CenterScreen"
        Background="#16161D"
        Foreground="White">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: Stacks List -->
        <Border Grid.Column="0" Background="#20212B" CornerRadius="10" Padding="12" BorderBrush="#26FFFFFF" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
                    <TextBlock Text="STACKBAR FOLDERS" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" VerticalAlignment="Center"/>
                </DockPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="+ New Stack Folder"
                            Click="AddGroup_Click"
                            Height="34"
                            Margin="0,0,0,6"
                            Background="#3A6DF0"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"/>
                    <Button Content="Delete Selected Stack"
                            Click="DeleteGroup_Click"
                            Height="28"
                            Background="#2A2B36"
                            Foreground="#CCFF6B6B"
                            FontSize="11.5"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </StackPanel>

                <ListBox x:Name="GroupsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         SelectionChanged="GroupsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,6">
                                <TextBlock Text="{Binding IconGlyph}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Items.Count, StringFormat='{}{0} apps'}" FontSize="10.5" Foreground="#88FFFFFF"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right Content: Selected Stack Editor -->
        <Border Grid.Column="2" Background="#20212B" CornerRadius="10" Padding="18" BorderBrush="#26FFFFFF" BorderThickness="1">
            <DockPanel x:Name="GroupEditorPanel">
                <!-- Top Action & Metadata Bar -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <DockPanel Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Preview Popup"
                                    Click="PreviewFlyout_Click"
                                    Padding="12,7"
                                    Margin="0,0,8,0"
                                    Background="#2E303E"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                            <Button Content="📌 Create Taskbar Shortcut"
                                    Click="CreateShortcut_Click"
                                    Padding="14,7"
                                    Background="#3A6DF0"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectedGroupHeader" Text="Select a Stack" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Folder Settings Row -->
                    <Border Background="#181922" CornerRadius="8" Padding="12,10" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Name:" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="GroupNameBox" Width="130" Padding="6,4" Background="#252632" Foreground="White" BorderBrush="#38FFFFFF" TextChanged="GroupMeta_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Emoji:" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="GroupGlyphBox" Width="44" Padding="6,4" TextAlignment="Center" Background="#252632" Foreground="White" BorderBrush="#38FFFFFF" TextChanged="GroupMeta_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="Taskbar Icon:" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="IconModeCombo" Width="165" Padding="6,4" SelectionChanged="IconModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="iOS 2x2 Mini-Icon Grid"/>
                                    <ComboBoxItem Content="Emoji Badge Icon"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Columns:" Foreground="#AAFFFFFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="ColumnsCombo" Width="54" Padding="6,4" SelectionChanged="ColumnsCombo_SelectionChanged">
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Toolbar: Import / Add / Remove -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="⚡ Import From My Taskbar"
                                Click="ImportTaskbar_Click"
                                Padding="12,7"
                                Margin="0,0,8,0"
                                Background="#2E303E"
                                Foreground="#80B3FF"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"/>
                        <Button Content="+ Add App / Shortcut..."
                                Click="AddAppFile_Click"
                                Padding="12,7"
                                Margin="0,0,8,0"
                                Background="#2E303E"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                        <Button Content="Remove App"
                                Click="RemoveSelectedApp_Click"
                                Padding="12,7"
                                Background="#2E303E"
                                Foreground="#FF8080"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Text="Tip: Drag &amp; drop any apps or shortcuts into the list, or click 'Import From My Taskbar'."
                               FontSize="11"
                               Foreground="#88FFFFFF"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"/>
                </DockPanel>

                <!-- Apps List inside Selected Stack -->
                <ListBox x:Name="ItemsListBox"
                         Background="#16171F"
                         BorderBrush="#28FFFFFF"
                         BorderThickness="1"
                         Foreground="White"
                         AllowDrop="True"
                         Drop="ItemsListBox_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="6,6">
                                <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="170" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TargetPath}" Foreground="#88FFFFFF" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
