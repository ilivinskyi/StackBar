<Window x:Class="TaskbarGrouper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Taskbar Grouper — Group Manager"
        Width="780"
        Height="500"
        WindowStartupLocation="CenterScreen"
        Background="#18181D"
        Foreground="White">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar: Groups List -->
        <Border Grid.Column="0" Background="#22222A" CornerRadius="8" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="GROUPS" FontSize="11" FontWeight="Bold" Foreground="#88FFFFFF" Margin="0,0,0,10"/>
                <Button DockPanel.Dock="Bottom"
                        Content="+ Add Group"
                        Click="AddGroup_Click"
                        Height="32"
                        Margin="0,10,0,0"
                        Background="#3A6DF0"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <ListBox x:Name="GroupsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         SelectionChanged="GroupsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,6">
                                <TextBlock Text="{Binding IconGlyph}" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Right Content: Selected Group Editor -->
        <Border Grid.Column="2" Background="#22222A" CornerRadius="8" Padding="16">
            <DockPanel x:Name="GroupEditorPanel">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="Preview Flyout"
                                Click="PreviewFlyout_Click"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Background="#2D2D38"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                        <Button Content="Save Config"
                                Click="SaveConfig_Click"
                                Padding="12,6"
                                Background="#28A745"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"/>
                    </StackPanel>
                    <TextBlock x:Name="SelectedGroupHeader" Text="Select a group" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock DockPanel.Dock="Bottom"
                           x:Name="StatusText"
                           Text="Tip: Drag &amp; drop .exe or .lnk files into the list below, or click 'Preview Flyout' to test the popup."
                           FontSize="11"
                           Foreground="#88FFFFFF"
                           Margin="0,10,0,0"/>

                <ListBox x:Name="ItemsListBox"
                         Background="#1A1A20"
                         BorderBrush="#33FFFFFF"
                         BorderThickness="1"
                         Foreground="White"
                         AllowDrop="True"
                         Drop="ItemsListBox_Drop">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,6">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="160"/>
                                <TextBlock Text="{Binding TargetPath}" Foreground="#99FFFFFF" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
