<Window x:Class="TaskbarGrouper.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StackBar Setup"
        Width="500"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Background="#14151E"
        Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="56" Height="56" CornerRadius="12" Background="#1D1F2B" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,16,0" Padding="4">
                <Image Source="pack://application:,,,/Assets/app_icon.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SetupTitle" Text="Install StackBar" FontSize="21" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Native Taskbar Folder Studio for Windows" FontSize="12" Foreground="#99FFFFFF" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Options Card -->
        <Border Grid.Row="1" Background="#1D1F2B" CornerRadius="10" Padding="16" BorderBrush="#28FFFFFF" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <CheckBox x:Name="DesktopShortcutCheck" Content="Create Desktop Shortcut" IsChecked="True" Foreground="#EEFFFFFF" FontSize="13" Margin="0,0,0,10"/>
                <CheckBox x:Name="StartMenuCheck" Content="Create Start Menu Shortcut" IsChecked="True" Foreground="#EEFFFFFF" FontSize="13" Margin="0,0,0,10"/>
                <CheckBox x:Name="StartupCheck" Content="Start StackBar in System Tray on Windows Login" IsChecked="True" Foreground="#EEFFFFFF" FontSize="13" Margin="0,0,0,10"/>
                <CheckBox x:Name="LaunchAfterCheck" Content="Launch StackBar immediately after installation" IsChecked="True" Foreground="#EEFFFFFF" FontSize="13" Margin="0,0,0,14"/>

                <!-- Location Row -->
                <Border Background="#151620" CornerRadius="6" Padding="10,8" BorderBrush="#1CFFFFFF" BorderThickness="1">
                    <DockPanel>
                        <Button x:Name="BrowseFolderBtn"
                                DockPanel.Dock="Right"
                                Content="Browse..."
                                Click="BrowseFolder_Click"
                                Style="{StaticResource SurfaceBtn}"
                                Padding="10,4"
                                Margin="8,0,0,0"/>
                        <TextBlock x:Name="StatusLabel"
                                   Text="%LocalAppData%\Programs\StackBar"
                                   FontSize="11.5"
                                   Foreground="#AAFFFFFF"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button x:Name="UninstallBtn"
                    Content="Uninstall..."
                    Click="Uninstall_Click"
                    Style="{StaticResource SurfaceBtn}"
                    Padding="14,8"
                    Foreground="#FF8080"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Style="{StaticResource SurfaceBtn}"
                        Padding="16,8"
                        Margin="0,0,8,0"/>
                <Button x:Name="InstallBtn"
                        Content="Install &amp; Launch"
                        Click="Install_Click"
                        Style="{StaticResource PrimaryBtn}"
                        Padding="20,8"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
