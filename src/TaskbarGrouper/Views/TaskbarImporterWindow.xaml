<Window x:Class="TaskbarGrouper.Views.TaskbarImporterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Apps into Stack Folder"
        Width="580"
        Height="540"
        WindowStartupLocation="CenterOwner"
        Background="#16171F"
        Foreground="White"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Import Applications" FontSize="16" FontWeight="Bold"/>
            <TextBlock Text="Select apps from your pinned taskbar, Windows Start menu, Store apps, or Desktop."
                       FontSize="11.5"
                       Foreground="#99FFFFFF"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Search Filter Box -->
        <Border Grid.Row="1" Background="#222330" CornerRadius="8" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="10,6" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="🔍" Foreground="#88FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="SearchBox"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0"
                         FontSize="13"
                         TextChanged="SearchBox_TextChanged"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Border Background="#1E1F2B" CornerRadius="10" BorderBrush="#28FFFFFF" BorderThickness="1" Padding="8">
                <ListBox x:Name="ShortcutsList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Foreground="White"
                                      Margin="4,5"
                                      VerticalContentAlignment="Center">
                                <DockPanel HorizontalAlignment="Stretch" Margin="0,0,8,0">
                                    <Border DockPanel.Dock="Right"
                                            Background="#22FFFFFF"
                                            CornerRadius="6"
                                            Padding="7,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SourceBadge}" FontSize="10.5" Foreground="#BBFFFFFF"/>
                                    </Border>
                                    <Image Source="{Binding Icon}" Width="24" Height="24" Margin="6,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{Binding Item.Name}" FontSize="13" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Loading overlay -->
            <Border x:Name="LoadingOverlay" Background="#DD16171F" CornerRadius="10" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Scanning system &amp; taskbar applications..." FontSize="13.5" Foreground="#CCFFFFFF" Margin="0,0,0,8"/>
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" BorderThickness="0" Background="#33FFFFFF" Foreground="#3A6DF0"/>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button Content="Select All"
                    Click="SelectAll_Click"
                    Padding="12,7"
                    Background="#282A38"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Background="#282A38"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Import Checked"
                        Click="Import_Click"
                        Padding="16,7"
                        Background="#3A6DF0"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
