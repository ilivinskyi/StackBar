<Window x:Class="TaskbarGrouper.Views.TaskbarImporterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Pinned Taskbar Icons"
        Width="480"
        Height="440"
        WindowStartupLocation="CenterOwner"
        Background="#18181F"
        Foreground="White"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Select Pinned Taskbar Apps to Import" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Checked apps will be added to your current StackBar folder."
                       FontSize="11.5"
                       Foreground="#99FFFFFF"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#22222C" CornerRadius="8" BorderBrush="#30FFFFFF" BorderThickness="1" Padding="8">
            <ListBox x:Name="ShortcutsList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Foreground="White"
                                  Margin="4,5"
                                  VerticalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="22" Height="22" Margin="6,0,10,0"/>
                                <TextBlock Text="{Binding Item.Name}" FontSize="13" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </CheckBox>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Select All"
                    Click="SelectAll_Click"
                    Padding="10,6"
                    Background="#2B2C38"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Background="#2B2C38"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
                <Button Content="Import Selected"
                        Click="Import_Click"
                        Padding="16,6"
                        Background="#3A6DF0"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
