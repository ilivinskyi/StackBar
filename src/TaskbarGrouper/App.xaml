<Application x:Class="TaskbarGrouper.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#E61E1E24"/>
        <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ItemHoverBrush" Color="#26FFFFFF"/>
    </Application.Resources>
</Application>
